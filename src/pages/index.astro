---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { eventInfo, programme, allStalls } from '../data/fairData';
---

<BaseLayout>
  <Navbar />
  
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-background">
        <img src="/images/hero-christmas.jpg" alt="Festive Christmas decorations" class="hero-bg-image" />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">Ashford School Parents & Friends Association</div>
          <h1 class="hero-title">Christmas Fair <span class="hero-year">2026</span></h1>
          <p class="hero-subtitle">A magical day of festive fun for the whole family</p>
          
          <div class="hero-details">
            <div class="hero-detail-item">
              <div>
                <div class="hero-detail-label">Date</div>
                <div class="hero-detail-value">{eventInfo.date}</div>
              </div>
            </div>
            <div class="hero-detail-item">
              <div>
                <div class="hero-detail-label">Time</div>
                <div class="hero-detail-value">{eventInfo.time}</div>
              </div>
            </div>
            <div class="hero-detail-item">
              <div>
                <div class="hero-detail-label">Location</div>
                <div class="hero-detail-value">{eventInfo.location}</div>
              </div>
            </div>
          </div>
          
          <div class="hero-actions">
            <a href="/programme" class="btn btn-primary">View Digital Programme</a>
            <a href="/stalls" class="btn btn-secondary">Browse Stalls</a>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Welcome Section -->
    <section class="welcome">
      <div class="container">
        <div class="welcome-grid">
          <div class="welcome-content">
            <div class="section-label">Welcome</div>
            <h2 class="section-heading">A Festive Tradition</h2>
            <div class="welcome-message">
              {eventInfo.welcomeMessage.split('\n\n').map((paragraph, index) => (
                <p key={index}>{paragraph}</p>
              ))}
            </div>
          </div>
          <div class="welcome-image-container">
            <img src="/images/christmas-tree.jpg" alt="Beautifully decorated Christmas tree" class="welcome-image" />
            <div class="welcome-image-frame"></div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Highlights Section -->
    <section class="highlights">
      <div class="container">
        <div class="section-header">
          <div class="section-label">Event Highlights</div>
          <h2 class="section-heading centered">What Awaits You</h2>
          <p class="section-intro">Festive fun for the whole family at the Great Chart Site</p>
        </div>
        <div class="highlights-grid">
          <article class="highlight-card">
            <div class="highlight-card-content">
              <h3>Santa's Grotto</h3>
              <p>Visit Santa in his grotto. Pre-booked slots every half hour with limited walk-in places available.</p>
              <a href="/programme#grotto" class="highlight-link">View times →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-content">
              <h3>Fairground Rides</h3>
              <p>Swing chairs, climbing wall, penalty shootout and large covered bouncy castle from Ellis Amusements.</p>
              <a href="/programme#fairground" class="highlight-link">Learn more →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-content">
              <h3>Live Performances</h3>
              <p>School Choir and Ashford Youth Jazz Orchestra providing festive entertainment throughout the afternoon.</p>
              <a href="/programme" class="highlight-link">See programme →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-content">
              <h3>{allStalls.length} Stalls</h3>
              <p>Handmade gifts, crafts, seasonal treats and more from independent stallholders and our school community.</p>
              <a href="/stalls" class="highlight-link">Browse directory →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-content">
              <h3>Raffle Prizes</h3>
              <p>Super raffle (£5) with amazing prizes including £500 Neptune Bar, cash prizes and luxury hampers. Draw at 3:15pm.</p>
              <a href="/raffle" class="highlight-link">View prizes →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-content">
              <h3>Nordic Café</h3>
              <p>Traditional Christmas café in Friars Hall serving hot food, homemade cakes and festive refreshments.</p>
              <a href="/visitor-info" class="highlight-link">Visitor info →</a>
            </div>
          </article>
        </div>
      </div>
    </section>
    
    <!-- Instagram Section -->
    <section class="instagram">
      <div class="container">
        <div class="instagram-grid">
          <div class="instagram-content">
            <div class="section-label">PFA Updates</div>
            <h2 class="section-heading">Follow the PFA</h2>
            <p class="instagram-description">
              Stay up to date with the latest news and preparations for the Christmas Fair from the Ashford School Parents & Friends Association.
            </p>
            <a href={eventInfo.instagramUrl} target="_blank" rel="noopener noreferrer" class="instagram-cta">
              <span>Follow {eventInfo.pfaInstagram}</span>
              <span class="instagram-arrow">→</span>
            </a>
          </div>
          <div class="instagram-visual">
            <div class="instagram-frame">
              <div class="instagram-header">
                <span class="instagram-handle">{eventInfo.pfaInstagram}</span>
              </div>
              <div class="instagram-placeholder">
                <p>Ashford School PFA</p>
                <p class="instagram-placeholder-sub">Updates and announcements</p>
                <a href={eventInfo.instagramUrl} target="_blank" rel="noopener noreferrer" class="instagram-placeholder-link">
                  View on Instagram
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Programme Preview -->
    <section class="programme-preview">
      <div class="container">
        <div class="section-header">
          <div class="section-label">On The Day</div>
          <h2 class="section-heading">Programme Highlights</h2>
          <a href="/programme" class="view-all-link">View full programme →</a>
        </div>
        <div class="programme-preview-grid">
          {programme.slice(0, 4).map(item => (
            <article class="programme-preview-card">
              <div class="programme-preview-time">
                <span class="programme-preview-time-value">{item.time}</span>
              </div>
              <div class="programme-preview-content">
                <h3>{item.name}</h3>
                <p class="programme-preview-location">{item.location}</p>
                <span class="programme-preview-category">{item.category}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 4rem 0 3rem;
    overflow: hidden;
  }
  
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  
  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(22, 41, 74, 0.88) 0%, 
      rgba(22, 41, 74, 0.72) 60%,
      rgba(161, 24, 52, 0.5) 100%
    );
  }
  
  .hero-container {
    position: relative;
    z-index: 1;
  }
  
  .hero-content {
    max-width: 650px;
    color: var(--white);
  }
  
  .hero-badge {
    display: inline-block;
    background: rgba(212, 173, 114, 0.25);
    color: var(--gold);
    padding: 0.5rem 1.25rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.75rem;
    border: 1px solid rgba(212, 173, 114, 0.5);
  }
  
  .hero-title {
    font-size: clamp(3rem, 7vw, 4.5rem);
    color: var(--white);
    margin-bottom: 0.75rem;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  
  .hero-year {
    color: var(--gold);
    font-style: italic;
  }
  
  .hero-subtitle {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-family: var(--font-serif);
    font-style: italic;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 2.5rem;
    line-height: 1.4;
  }
  
  .hero-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  
  .hero-detail-item {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  
  .hero-detail-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  
  .hero-detail-value {
    font-weight: 600;
    color: var(--white);
    font-size: 1rem;
  }
  
  .hero-actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    min-height: 50px;
  }
  
  .btn-primary {
    background: var(--accent);
    color: var(--white);
  }
  
  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(161, 24, 52, 0.4);
  }
  
  .btn-secondary {
    background: rgba(255, 255, 255, 0.18);
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(8px);
  }
  
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.28);
    border-color: var(--white);
    transform: translateY(-2px);
  }
  
  .welcome {
    padding: 5rem 0;
  }
  
  .welcome-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .section-label {
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    margin-bottom: 0.875rem;
  }
  
  .section-heading {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    margin-bottom: 1.5rem;
    color: var(--navy);
    line-height: 1.18;
    font-weight: 600;
  }
  
  .section-heading.centered {
    text-align: center;
  }
  
  .welcome-message p {
    font-size: 1.02rem;
    line-height: 1.85;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }
  
  .welcome-image-container {
    position: relative;
  }
  
  .welcome-image {
    width: 100%;
    height: 420px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 70px rgba(22, 41, 74, 0.16);
  }
  
  .welcome-image-frame {
    position: absolute;
    inset: -14px;
    border: 2px solid var(--gold);
    border-radius: var(--radius-lg);
    pointer-events: none;
    opacity: 0.7;
  }
  
  .highlights {
    padding: 5rem 0;
    background: linear-gradient(to bottom, rgba(229, 224, 214, 0.35) 0%, rgba(248, 245, 237, 0.6) 100%);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .section-intro {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-top: 0.75rem;
  }
  
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  
  .highlight-card {
    background: var(--surface);
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 3px 16px rgba(22, 41, 74, 0.06);
    transition: all 0.25s ease;
  }
  
  .highlight-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(22, 41, 74, 0.1);
    border-color: rgba(35, 99, 75, 0.4);
  }
  
  .highlight-card-content h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    color: var(--navy);
    font-weight: 600;
  }
  
  .highlight-card-content p {
    color: var(--text-primary);
    margin-bottom: 0.875rem;
    font-size: 0.95rem;
    line-height: 1.75;
  }
  
  .highlight-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .highlight-link:hover {
    text-decoration: underline;
  }
  
  .instagram {
    padding: 5rem 0;
  }
  
  .instagram-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .instagram-description {
    font-size: 1.02rem;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }
  
  .instagram-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--surface);
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-md);
    border: 2px solid var(--border-subtle);
    color: var(--navy);
    font-weight: 600;
    transition: all 0.2s ease;
  }
  
  .instagram-cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  
  .instagram-arrow {
    color: var(--accent);
  }
  
  .instagram-frame {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(22, 41, 74, 0.12);
  }
  
  .instagram-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-alt);
  }
  
  .instagram-handle {
    font-weight: 600;
    color: var(--navy);
    font-size: 0.95rem;
  }
  
  .instagram-placeholder {
    padding: 3rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(161, 24, 52, 0.05) 0%, rgba(248, 245, 237, 0.8) 100%);
  }
  
  .instagram-placeholder p {
    color: var(--navy);
    font-weight: 600;
    margin-bottom: 0.375rem;
    font-size: 1.1rem;
  }
  
  .instagram-placeholder-sub {
    color: var(--text-secondary) !important;
    font-weight: 400 !important;
    font-size: 0.9rem !important;
    margin-bottom: 1rem !important;
  }
  
  .instagram-placeholder-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .instagram-placeholder-link:hover {
    text-decoration: underline;
  }
  
  .programme-preview {
    padding: 5rem 0 6rem;
  }
  
  .section-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 2.5rem;
  }
  
  .view-all-link {
    color: var(--accent);
    font-weight: 600;
    margin-top: 0.75rem;
    align-self: flex-start;
  }
  
  .view-all-link:hover {
    text-decoration: underline;
  }
  
  .programme-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  
  .programme-preview-card {
    display: flex;
    gap: 1rem;
    background: var(--surface);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--evergreen);
    align-items: flex-start;
    transition: all 0.2s ease;
  }
  
  .programme-preview-card:hover {
    box-shadow: 0 4px 16px rgba(22, 41, 74, 0.07);
  }
  
  .programme-preview-time {
    flex-shrink: 0;
    background: rgba(35, 99, 75, 0.1);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  
  .programme-preview-time-value {
    font-weight: 600;
    color: var(--evergreen);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  
  .programme-preview-content h3 {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    margin-bottom: 0.375rem;
    color: var(--navy);
    font-weight: 600;
    line-height: 1.4;
  }
  
  .programme-preview-location {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin-bottom: 0.375rem;
    line-height: 1.4;
  }
  
  .programme-preview-category {
    display: inline-block;
    background: rgba(161, 24, 52, 0.1);
    color: var(--accent);
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  @media (max-width: 968px) {
    .welcome-grid,
    .instagram-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    
    .welcome-image {
      height: 340px;
    }
  }
  
  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: 3rem 0 2.5rem;
    }
    
    .hero-details {
      grid-template-columns: 1fr;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    
    .btn {
      width: 100%;
    }
    
    .highlights-grid {
      grid-template-columns: 1fr;
    }
    
    .programme-preview-grid {
      grid-template-columns: 1fr;
    }
    
    .programme-preview-card {
      flex-direction: column;
    }
  }
</style>
