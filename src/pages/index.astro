---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { eventInfo, programme, allStalls } from '../data/fairData';
---

<BaseLayout>
  <Navbar />

  <main id="main-content">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-background">
        <img
          src="/images/hero-christmas.jpg"
          alt=""
          class="hero-bg-image"
          width="1800"
          height="1201"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <p class="hero-eyebrow">Ashford School Parents &amp; Friends Association</p>
          <h1 class="hero-title">Christmas Fair <em>2026</em></h1>
          <p class="hero-subtitle">A magical day of festive fun for the whole family</p>

          <dl class="hero-details">
            <div class="hero-detail">
              <dt>Date</dt>
              <dd>{eventInfo.date}</dd>
            </div>
            <div class="hero-detail">
              <dt>Time</dt>
              <dd>{eventInfo.time}</dd>
            </div>
            <div class="hero-detail">
              <dt>Location</dt>
              <dd>
                <a href={eventInfo.mapsUrl} target="_blank" rel="noopener noreferrer">
                  {eventInfo.location}
                  <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M7 17 17 7M17 7H9M17 7v8" />
                  </svg>
                  <span class="sr-only">(opens in Google Maps)</span>
                </a>
              </dd>
            </div>
          </dl>

          <div class="hero-actions">
            <a href="/programme" class="btn btn-primary">View the programme</a>
            <a href="/stalls" class="btn btn-secondary">Browse stalls</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Welcome -->
    <section class="welcome">
      <div class="container welcome-grid">
        <div class="welcome-content">
          <p class="section-label">Welcome</p>
          <h2 class="section-heading">A festive tradition</h2>
          <div class="welcome-message">
            {eventInfo.welcomeMessage.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <figure class="welcome-figure">
          <img
            src="/images/gifts.jpg"
            alt="Wrapped Christmas gifts tied with red ribbon and berries"
            class="welcome-image"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- Highlights -->
    <section class="highlights">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="section-label">Event highlights</p>
          <h2 class="section-heading">What awaits you</h2>
          <p class="section-intro">
            {`Festive fun for the whole family across the Great Chart site, from Santa's Grotto to ${allStalls.length} stalls of handmade gifts and seasonal treats.`}
          </p>
        </div>

        <div class="highlights-grid">
          <article class="highlight">
            <h3>Santa's Grotto</h3>
            <p>
              Visit Santa in his grotto. Slots run every half hour, with a limited number available
              to turn up on the day.
            </p>
            <a href="/programme#grotto" class="text-link">Times and details</a>
          </article>
          <article class="highlight">
            <h3>Fairground rides</h3>
            <p>
              Swing chairs, climbing wall and penalty shootout, plus a large covered bouncy castle
              supplied by Ellis Amusements.
            </p>
            <a href="/programme#fairground" class="text-link">Times and details</a>
          </article>
          <article class="highlight">
            <h3>Live performances</h3>
            <p>
              The School Choir and Ashford Youth Jazz Orchestra perform through the afternoon at the
              front of the school.
            </p>
            <a href="/programme" class="text-link">See the programme</a>
          </article>
          <article class="highlight">
            <h3>{allStalls.length} stalls</h3>
            <p>
              Handmade gifts, crafts, wines and seasonal treats from independent stallholders and the
              school community.
            </p>
            <a href="/stalls" class="text-link">Browse the directory</a>
          </article>
          <article class="highlight">
            <h3>Raffle</h3>
            <p>
              A super raffle at £5 a ticket with a £500 Neptune bar and cash prizes, plus an everyday
              raffle at £1. Drawn at 3:15pm.
            </p>
            <a href="/raffle" class="text-link">See the prizes</a>
          </article>
          <article class="highlight">
            <h3>Nordic café</h3>
            <p>
              A traditional Christmas café in Friars Hall serving hot food, homemade cakes and
              refreshments throughout the afternoon.
            </p>
            <a href="/visitor-info" class="text-link">Visitor information</a>
          </article>
        </div>
      </div>
    </section>

    <!-- Programme preview -->
    <section class="programme">
      <div class="container">
        <div class="section-head">
          <p class="section-label">On the day</p>
          <h2 class="section-heading">From the programme</h2>
        </div>

        <ol class="programme-list">
          {
            programme.slice(0, 4).map((item) => (
              <li class="programme-row">
                <span class="programme-time">{item.time}</span>
                <span class="programme-body">
                  <span class="programme-name">{item.name}</span>
                  <span class="programme-location">{item.location}</span>
                </span>
                <span class="programme-tag">{item.category}</span>
              </li>
            ))
          }
        </ol>

        <p class="programme-more">
          <a href="/programme" class="text-link text-link--strong">View the full programme</a>
        </p>
      </div>
    </section>

    <!-- Instagram -->
    <section class="instagram">
      <div class="container instagram-grid">
        <div class="instagram-copy">
          <p class="section-label">From the PFA</p>
          <h2 class="section-heading">Follow the PFA</h2>
          <p class="instagram-description">
            Fair announcements and news from the Ashford School Parents &amp; Friends Association are
            shared on Instagram.
          </p>
          <a
            href={eventInfo.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="instagram-link"
          >
            <svg class="instagram-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
            </svg>
            <span>{eventInfo.pfaInstagram}</span>
          </a>
        </div>

        <div class="instagram-embed" data-instagram-embed={eventInfo.instagramEmbedUrl}>
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={`${eventInfo.instagramEmbedUrl}?utm_source=ig_embed&utm_campaign=loading`}
            data-instgrm-version="14"
          >
            <a
              class="instagram-embed-fallback"
              href={eventInfo.instagramEmbedUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="instagram-embed-fallback__label">Latest post</span>
              <span class="instagram-embed-fallback__title">
                Welcome to our new Ashford School PFA Instagram page
              </span>
              <span class="instagram-embed-fallback__cta">View on Instagram</span>
            </a>
          </blockquote>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Load Instagram's embed script only when the post scrolls into view.
  const embedHost = document.querySelector('[data-instagram-embed]');

  if (embedHost) {
    let loaded = false;

    const loadEmbed = () => {
      if (loaded) return;
      loaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.instagram.com/embed.js';
      script.onload = () => {
        const ig = window.instgrm;
        if (ig && ig.Embeds) ig.Embeds.process();
      };
      document.body.appendChild(script);
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            loadEmbed();
          }
        },
        { rootMargin: '300px' }
      );
      observer.observe(embedHost);
    } else {
      loadEmbed();
    }
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(78vh, 720px);
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(22, 41, 74, 0.92) 0%,
      rgba(22, 41, 74, 0.78) 45%,
      rgba(22, 41, 74, 0.42) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 640px;
    color: var(--pure-white);
  }

  .hero-eyebrow {
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    color: var(--pure-white);
    font-size: clamp(2.9rem, 7vw, 4.6rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.025em;
    margin-bottom: 0.9rem;
  }

  .hero-title em {
    color: var(--gold);
    font-style: italic;
  }

  .hero-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    color: rgba(255, 255, 255, 0.94);
    line-height: 1.4;
    margin-bottom: 2.4rem;
  }

  .hero-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
    margin: 0 0 2.4rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  .hero-detail dt {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 0.3rem;
    font-weight: 600;
  }

  .hero-detail dd {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--pure-white);
    line-height: 1.45;
  }

  .hero-detail dd a {
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 1px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .hero-detail dd a:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .external-icon {
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    margin-left: 0.25em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vertical-align: baseline;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0.8rem 1.9rem;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: 0.93rem;
    font-weight: 600;
    border: 1px solid transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease,
      transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--pure-white);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(161, 24, 52, 0.32);
  }

  .btn-secondary {
    background: transparent;
    color: var(--pure-white);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--pure-white);
  }

  /* ---------- Shared section type ---------- */
  .section-label {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }

  .section-heading {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.14;
    color: var(--navy);
    margin-bottom: 1rem;
  }

  .section-head {
    margin-bottom: 2.75rem;
  }

  .section-head--center {
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-intro {
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.7;
    margin: 0;
  }

  .text-link {
    display: inline-block;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    border-bottom: 1px solid rgba(161, 24, 52, 0.35);
    padding-bottom: 1px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .text-link:hover {
    color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .text-link--strong {
    font-size: 0.98rem;
  }

  /* ---------- Welcome ---------- */
  .welcome {
    padding: 5.5rem 0;
  }

  .welcome-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 4rem;
    align-items: center;
  }

  .welcome-message p {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--text-primary);
    margin-bottom: 1.15rem;
  }

  .welcome-message p:last-child {
    margin-bottom: 0;
  }

  .welcome-figure {
    margin: 0;
    position: relative;
  }

  .welcome-figure::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
    transform: translate(14px, 14px);
    pointer-events: none;
  }

  .welcome-image {
    position: relative;
    width: 100%;
    height: 440px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgba(22, 41, 74, 0.14);
  }

  /* ---------- Highlights ---------- */
  .highlights {
    padding: 5rem 0;
    background: #f2eee4;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid rgba(22, 41, 74, 0.14);
  }

  .highlight {
    padding: 2rem 1.9rem;
    border-right: 1px solid rgba(22, 41, 74, 0.14);
    border-bottom: 1px solid rgba(22, 41, 74, 0.14);
  }

  .highlight:nth-child(3n) {
    border-right: none;
  }

  .highlight:nth-last-child(-n + 3) {
    border-bottom: none;
  }

  .highlight h3 {
    font-size: 1.4rem;
    line-height: 1.25;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }

  .highlight p {
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* ---------- Programme ---------- */
  .programme {
    padding: 5.5rem 0;
    background: var(--evergreen);
    color: rgba(255, 255, 255, 0.9);
  }

  .programme .section-label {
    color: var(--gold);
  }

  .programme .section-heading {
    color: var(--pure-white);
  }

  .programme-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .programme-row {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 2rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  .programme-time {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
    letter-spacing: 0.01em;
  }

  .programme-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .programme-name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--pure-white);
    line-height: 1.25;
  }

  .programme-location {
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.5;
  }

  .programme-tag {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    white-space: nowrap;
    padding-top: 0.35rem;
  }

  .programme-more {
    margin: 0;
  }

  .programme .text-link {
    color: var(--gold);
    border-color: rgba(212, 173, 114, 0.5);
  }

  .programme .text-link:hover {
    color: var(--pure-white);
    border-color: rgba(255, 255, 255, 0.7);
  }

  /* ---------- Instagram ---------- */
  .instagram {
    padding: 5rem 0 5.5rem;
    background: #f2eee4;
    border-top: 1px solid var(--border-subtle);
  }

  .instagram-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 4rem;
    align-items: center;
  }

  .instagram-description {
    color: var(--text-primary);
    font-size: 1.02rem;
    line-height: 1.8;
    margin-bottom: 1.75rem;
  }

  .instagram-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--navy);
    font-weight: 600;
    font-size: 0.98rem;
    padding: 0.7rem 1.25rem;
    background: var(--pure-white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .instagram-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .instagram-icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }

  .instagram-embed {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .instagram-embed :global(.instagram-media) {
    margin: 0 !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 380px !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: var(--shadow-lg) !important;
    border: 1px solid var(--border-subtle) !important;
    background: var(--pure-white) !important;
    overflow: hidden;
  }

  /* Shown until (or instead of) Instagram's embed script replacing it. */
  .instagram-embed :global(.instagram-embed-fallback) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2.5rem 1.75rem;
    text-align: center;
    color: var(--navy);
    background: var(--pure-white);
    border-radius: var(--radius-lg);
  }

  .instagram-embed :global(.instagram-embed-fallback__label) {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .instagram-embed :global(.instagram-embed-fallback__title) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .instagram-embed :global(.instagram-embed-fallback__cta) {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1000px) {
    .highlights-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .highlight:nth-child(3n) {
      border-right: 1px solid rgba(22, 41, 74, 0.14);
    }

    .highlight:nth-child(2n) {
      border-right: none;
    }

    .highlight:nth-last-child(-n + 3) {
      border-bottom: 1px solid rgba(22, 41, 74, 0.14);
    }

    .highlight:nth-last-child(-n + 2) {
      border-bottom: none;
    }
  }

  @media (max-width: 900px) {
    .welcome-grid,
    .instagram-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .welcome-figure {
      max-width: 520px;
    }

    .welcome-image {
      height: 340px;
    }

    .programme-row {
      grid-template-columns: 140px 1fr auto;
      gap: 1.25rem;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: auto;
      padding: 3.25rem 0 2.75rem;
    }

    .hero-details {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.15rem 0;
    }

    .hero-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }

    .welcome,
    .programme {
      padding: 3.75rem 0;
    }

    .highlights,
    .instagram {
      padding: 3.75rem 0;
    }

    .highlights-grid {
      grid-template-columns: 1fr;
    }

    .highlight {
      border-right: none !important;
      padding: 1.6rem 0;
    }

    .highlight:last-child {
      border-bottom: none;
    }

    .programme-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1.15rem 0;
    }

    .programme-tag {
      padding-top: 0.15rem;
    }

    .welcome-image {
      height: 260px;
    }

    .welcome-figure::after {
      display: none;
    }
  }
</style>
