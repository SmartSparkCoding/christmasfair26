---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { eventInfo, programme, allStalls } from '../data/fairData';
---

<BaseLayout>
  <Navbar />
  
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-background">
        <img src="/images/hero-christmas.jpg" alt="Festive Christmas decorations" class="hero-bg-image" />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">Ashford School Parents & Friends Association</div>
          <h1 class="hero-title">Christmas Fair <span class="hero-year">2026</span></h1>
          <p class="hero-subtitle">A magical day of festive fun for the whole family</p>
          
          <div class="hero-details">
            <div class="hero-detail-item">
              <div class="hero-detail-icon">📅</div>
              <div>
                <div class="hero-detail-label">Date</div>
                <div class="hero-detail-value">{eventInfo.date}</div>
              </div>
            </div>
            <div class="hero-detail-item">
              <div class="hero-detail-icon">🕐</div>
              <div>
                <div class="hero-detail-label">Time</div>
                <div class="hero-detail-value">{eventInfo.time}</div>
              </div>
            </div>
            <div class="hero-detail-item">
              <div class="hero-detail-icon">📍</div>
              <div>
                <div class="hero-detail-label">Location</div>
                <div class="hero-detail-value">{eventInfo.location}</div>
              </div>
            </div>
          </div>
          
          <div class="hero-actions">
            <a href="/programme" class="btn btn-primary">View Digital Programme</a>
            <a href="/stalls" class="btn btn-secondary">Browse Stalls</a>
          </div>
        </div>
      </div>
      <div class="hero-decoration hero-decoration-left">🎄</div>
      <div class="hero-decoration hero-decoration-right">✨</div>
    </section>
    
    <!-- Welcome Section -->
    <section class="welcome">
      <div class="container">
        <div class="welcome-grid">
          <div class="welcome-content">
            <div class="section-label">Welcome</div>
            <h2 class="section-heading">A Festive Tradition</h2>
            <div class="welcome-message">
              {eventInfo.welcomeMessage.split('\n\n').map((paragraph, index) => (
                <p key={index}>{paragraph}</p>
              ))}
            </div>
          </div>
          <div class="welcome-image-container">
            <img src="/images/christmas-tree.jpg" alt="Beautifully decorated Christmas tree" class="welcome-image" />
            <div class="welcome-image-frame"></div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Highlights Section -->
    <section class="highlights">
      <div class="container">
        <div class="section-header">
          <div class="section-label">Event Highlights</div>
          <h2 class="section-heading centered">What Awaits You</h2>
          <p class="section-intro">Festive fun for the whole family at the Great Chart Site</p>
        </div>
        <div class="highlights-grid">
          <article class="highlight-card">
            <div class="highlight-card-image">
              <div class="highlight-emoji">🎅</div>
            </div>
            <div class="highlight-card-content">
              <h3>Santa's Grotto</h3>
              <p>Visit Santa in his grotto! Pre-booked slots every half hour with limited walk-in places available.</p>
              <a href="/programme#grotto" class="highlight-link">View times →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-image">
              <div class="highlight-emoji">🎠</div>
            </div>
            <div class="highlight-card-content">
              <h3>Fairground Rides</h3>
              <p>Swing chairs, climbing wall, penalty shootout and large covered bouncy castle from Ellis Amusements.</p>
              <a href="/programme#fairground" class="highlight-link">Learn more →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-image">
              <div class="highlight-emoji">🎵</div>
            </div>
            <div class="highlight-card-content">
              <h3>Live Performances</h3>
              <p>School Choir and Ashford Youth Jazz Orchestra providing festive entertainment throughout the afternoon.</p>
              <a href="/programme" class="highlight-link">See programme →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-image">
              <div class="highlight-emoji">🛍️</div>
            </div>
            <div class="highlight-card-content">
              <h3>{allStalls.length} Stalls</h3>
              <p>Handmade gifts, crafts, seasonal treats and more from independent stallholders and our school community.</p>
              <a href="/stalls" class="highlight-link">Browse directory →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-image">
              <div class="highlight-emoji">🎟️</div>
            </div>
            <div class="highlight-card-content">
              <h3>Raffle Prizes</h3>
              <p>Super raffle (£5) with amazing prizes including £500 Neptune Bar, cash prizes and luxury hampers. Draw at 3:15pm.</p>
              <a href="/raffle" class="highlight-link">View prizes →</a>
            </div>
          </article>
          <article class="highlight-card">
            <div class="highlight-card-image">
              <div class="highlight-emoji">☕</div>
            </div>
            <div class="highlight-card-content">
              <h3>Nordic Café</h3>
              <p>Traditional Christmas café in Friars Hall serving hot food, homemade cakes and festive refreshments.</p>
              <a href="/visitor-info" class="highlight-link">Visitor info →</a>
            </div>
          </article>
        </div>
      </div>
    </section>
    
    <!-- Instagram Section -->
    <section class="instagram">
      <div class="container">
        <div class="instagram-grid">
          <div class="instagram-content">
            <div class="section-label">Follow Along</div>
            <h2 class="section-heading">From Ashford School</h2>
            <p class="instagram-description">
              See the latest festive preparations, school news and event updates from Ashford School on Instagram.
            </p>
            <a href="https://www.instagram.com/ashfordschool/" target="_blank" rel="noopener noreferrer" class="instagram-cta">
              <img src="/images/ashford-ig.jpg" alt="Ashford School" class="instagram-avatar" />
              <span>@ashfordschool</span>
              <span class="instagram-arrow">→</span>
            </a>
          </div>
          <div class="instagram-visual">
            <div class="instagram-frame">
              <div class="instagram-header">
                <img src="/images/ashford-ig.jpg" alt="Ashford School" class="instagram-mini-avatar" />
                <span class="instagram-handle">ashfordschool</span>
              </div>
              <div class="instagram-placeholder">
                <div class="instagram-placeholder-icon">📸</div>
                <p>Follow for festive updates</p>
                <a href="https://www.instagram.com/ashfordschool/" target="_blank" rel="noopener noreferrer" class="instagram-placeholder-link">
                  View on Instagram
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Programme Preview -->
    <section class="programme-preview">
      <div class="container">
        <div class="section-header">
          <div class="section-label">On The Day</div>
          <h2 class="section-heading">Programme Highlights</h2>
          <a href="/programme" class="view-all-link">View full programme →</a>
        </div>
        <div class="programme-preview-grid">
          {programme.slice(0, 4).map(item => (
            <article class="programme-preview-card">
              <div class="programme-preview-time">
                <span class="programme-preview-time-value">{item.time}</span>
              </div>
              <div class="programme-preview-content">
                <h3>{item.name}</h3>
                <p class="programme-preview-location">📍 {item.location}</p>
                <span class="programme-preview-category">{item.category}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 4rem 0 3rem;
    overflow: hidden;
  }
  
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  
  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(22, 41, 74, 0.85) 0%, 
      rgba(22, 41, 74, 0.65) 50%,
      rgba(161, 24, 52, 0.4) 100%
    );
  }
  
  .hero-container {
    position: relative;
    z-index: 1;
  }
  
  .hero-content {
    max-width: 700px;
    color: var(--white);
  }
  
  .hero-badge {
    display: inline-block;
    background: rgba(212, 173, 114, 0.2);
    color: var(--gold);
    padding: 0.375rem 1rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(212, 173, 114, 0.4);
  }
  
  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--white);
    margin-bottom: 0.75rem;
    font-weight: 700;
    line-height: 1.05;
  }
  
  .hero-year {
    color: var(--gold);
    font-style: italic;
  }
  
  .hero-subtitle {
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    font-family: var(--font-serif);
    font-style: italic;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 2.5rem;
    line-height: 1.4;
  }
  
  .hero-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  
  .hero-detail-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .hero-detail-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  
  .hero-detail-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  
  .hero-detail-value {
    font-weight: 600;
    color: var(--white);
    font-size: 1rem;
  }
  
  .hero-actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.25s ease;
    border: 2px solid transparent;
    min-height: 52px;
  }
  
  .btn-primary {
    background: var(--accent);
    color: var(--white);
  }
  
  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(161, 24, 52, 0.4);
  }
  
  .btn-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
  }
  
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: var(--white);
    transform: translateY(-2px);
  }
  
  .hero-decoration {
    position: absolute;
    font-size: 4rem;
    opacity: 0.4;
    pointer-events: none;
    z-index: 1;
    animation: float 8s ease-in-out infinite;
  }
  
  .hero-decoration-left {
    top: 20%;
    left: 3%;
    animation-delay: 0s;
  }
  
  .hero-decoration-right {
    bottom: 15%;
    right: 5%;
    animation-delay: 4s;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    25% { transform: translateY(-15px) rotate(5deg); }
    50% { transform: translateY(-10px) rotate(-5deg); }
    75% { transform: translateY(-20px) rotate(3deg); }
  }
  
  .welcome {
    padding: 5rem 0;
  }
  
  .welcome-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .section-label {
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }
  
  .section-heading {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 1.5rem;
    color: var(--navy);
    line-height: 1.15;
  }
  
  .section-heading.centered {
    text-align: center;
  }
  
  .welcome-message p {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }
  
  .welcome-image-container {
    position: relative;
  }
  
  .welcome-image {
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(22, 41, 74, 0.15);
  }
  
  .welcome-image-frame {
    position: absolute;
    inset: -12px;
    border: 3px solid var(--gold);
    border-radius: var(--radius-lg);
    pointer-events: none;
    opacity: 0.6;
  }
  
  .highlights {
    padding: 5rem 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(229, 224, 214, 0.4) 100%);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .section-intro {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-top: 0.75rem;
  }
  
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }
  
  .highlight-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 4px 20px rgba(22, 41, 74, 0.06);
    transition: all 0.3s ease;
  }
  
  .highlight-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(22, 41, 74, 0.12);
  }
  
  .highlight-card-image {
    background: linear-gradient(135deg, rgba(35, 99, 75, 0.1) 0%, rgba(161, 24, 52, 0.1) 100%);
    padding: 2rem;
    text-align: center;
  }
  
  .highlight-emoji {
    font-size: 3rem;
  }
  
  .highlight-card-content {
    padding: 1.75rem;
  }
  
  .highlight-card-content h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: var(--navy);
  }
  
  .highlight-card-content p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
  }
  
  .highlight-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .highlight-link:hover {
    text-decoration: underline;
  }
  
  .instagram {
    padding: 5rem 0;
  }
  
  .instagram-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .instagram-description {
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  
  .instagram-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    background: var(--surface);
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-md);
    border: 2px solid var(--border-subtle);
    color: var(--navy);
    font-weight: 600;
    transition: all 0.2s ease;
  }
  
  .instagram-cta:hover {
    border-color: var(--navy);
    transform: translateX(4px);
  }
  
  .instagram-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .instagram-arrow {
    color: var(--accent);
    font-size: 1.25rem;
  }
  
  .instagram-frame {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(22, 41, 74, 0.12);
  }
  
  .instagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .instagram-mini-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .instagram-handle {
    font-weight: 600;
    color: var(--navy);
    font-size: 0.9rem;
  }
  
  .instagram-placeholder {
    padding: 3rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(35, 99, 75, 0.05) 0%, rgba(161, 24, 52, 0.05) 100%);
  }
  
  .instagram-placeholder-icon {
    font-size: 3rem;
    margin-bottom: 0.75rem;
  }
  
  .instagram-placeholder p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  
  .instagram-placeholder-link {
    color: var(--accent);
    font-weight: 600;
  }
  
  .instagram-placeholder-link:hover {
    text-decoration: underline;
  }
  
  .programme-preview {
    padding: 5rem 0 6rem;
  }
  
  .section-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 2.5rem;
  }
  
  .view-all-link {
    color: var(--accent);
    font-weight: 600;
    margin-top: 0.5rem;
    align-self: flex-start;
  }
  
  .view-all-link:hover {
    text-decoration: underline;
  }
  
  .programme-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  
  .programme-preview-card {
    display: flex;
    gap: 1rem;
    background: var(--surface);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--evergreen);
    align-items: flex-start;
    transition: all 0.2s ease;
  }
  
  .programme-preview-card:hover {
    box-shadow: 0 4px 16px rgba(22, 41, 74, 0.08);
  }
  
  .programme-preview-time {
    flex-shrink: 0;
    background: rgba(35, 99, 75, 0.1);
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-md);
  }
  
  .programme-preview-time-value {
    font-weight: 600;
    color: var(--evergreen);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  
  .programme-preview-content h3 {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    margin-bottom: 0.375rem;
    color: var(--navy);
    font-weight: 600;
  }
  
  .programme-preview-location {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin-bottom: 0.375rem;
  }
  
  .programme-preview-category {
    display: inline-block;
    background: rgba(161, 24, 52, 0.1);
    color: var(--accent);
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  @media (max-width: 968px) {
    .welcome-grid,
    .instagram-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .welcome-image {
      height: 300px;
    }
  }
  
  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: 3rem 0 2.5rem;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    
    .btn {
      width: 100%;
    }
    
    .hero-decoration {
      display: none;
    }
    
    .highlights-grid {
      grid-template-columns: 1fr;
    }
    
    .programme-preview-grid {
      grid-template-columns: 1fr;
    }
    
    .programme-preview-card {
      flex-direction: column;
    }
  }
</style>
