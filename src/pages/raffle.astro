---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { raffleInfo, superRafflePrizes, everydayRafflePrizes } from '../data/fairData';
---

<BaseLayout
  title="Raffle | Ashford School Christmas Fair 2026"
  description="Raffle prizes at the Ashford School Christmas Fair 2026, including the £5 super raffle and £1 everyday raffle. Drawn at 3:15pm in Main Reception."
>
  <Navbar />

  <main id="main-content">
    <header class="page-header">
      <div class="container">
        <p class="page-header__label">Raffle</p>
        <h1 class="page-header__title">Win something special</h1>
        <p class="page-header__intro">
          Two raffles, drawn on the day at 3:15pm in Main Reception. Every ticket helps fund
          initiatives and projects for the school community.
        </p>
      </div>
    </header>

    <section class="raffle-section">
      <div class="container">
        <dl class="raffle-facts">
          <div class="fact">
            <dt>Everyday raffle</dt>
            <dd>{raffleInfo.tickets.everyday.price}</dd>
          </div>
          <div class="fact">
            <dt>Super raffle</dt>
            <dd>{raffleInfo.tickets.super.price}</dd>
          </div>
          <div class="fact">
            <dt>Super raffle tickets</dt>
            <dd>Only {raffleInfo.tickets.super.limit} available</dd>
          </div>
          <div class="fact">
            <dt>Draw</dt>
            <dd>{raffleInfo.drawTime}</dd>
          </div>
        </dl>

        <p class="purchase-note">{raffleInfo.purchase} {raffleInfo.drawDescription}</p>

        <section class="prize-block" aria-labelledby="super-prizes">
          <div class="prize-head">
            <h2 id="super-prizes">Super raffle prizes</h2>
            <p class="prize-sub">
              £5 a ticket &middot; only {raffleInfo.tickets.super.limit} tickets sold
            </p>
          </div>
          <ol class="super-list">
            {
              superRafflePrizes.map((prize) => {
                const [item, donor] = prize.split(' - ');
                return (
                  <li class="super-prize">
                    <span class="super-prize__item">{item}</span>
                    {donor && <span class="super-prize__donor">{donor}</span>}
                  </li>
                );
              })
            }
          </ol>
        </section>

        <section class="prize-block" aria-labelledby="everyday-prizes">
          <div class="prize-head">
            <h2 id="everyday-prizes">Everyday raffle prizes</h2>
            <p class="prize-sub">£1 a ticket &middot; donated with our sincere thanks</p>
          </div>
          <ul class="everyday-list">
            {everydayRafflePrizes.map((prize) => <li>{prize}</li>)}
          </ul>
        </section>

        <p class="raffle-footnote">
          Prizes and donors are listed as provided by the Parents &amp; Friends Association.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .raffle-section {
    padding: 2.75rem 0 5rem;
  }

  .raffle-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    margin: 0 0 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .fact dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.3rem;
  }

  .fact dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.45;
  }

  .purchase-note {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 46rem;
    margin-bottom: 3rem;
  }

  .prize-block {
    margin-bottom: 3rem;
  }

  .prize-head {
    margin-bottom: 1.25rem;
  }

  .prize-head h2 {
    font-size: 1.9rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .prize-sub {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  .super-list {
    list-style: none;
    counter-reset: prize;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .super-prize {
    counter-increment: prize;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .super-prize::before {
    content: counter(prize, decimal-leading-zero);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--soft-gold);
    letter-spacing: 0.02em;
  }

  .super-prize__item {
    font-size: 0.98rem;
    color: var(--text-primary);
    line-height: 1.6;
  }

  .super-prize__donor {
    font-size: 0.84rem;
    color: var(--text-secondary);
    text-align: right;
    line-height: 1.5;
  }

  .everyday-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .everyday-list li {
    padding: 0.7rem 0;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.92rem;
    color: var(--text-primary);
    line-height: 1.55;
  }

  .raffle-footnote {
    font-size: 0.85rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .raffle-facts {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .everyday-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .super-prize {
      grid-template-columns: 2rem 1fr;
    }

    .super-prize__donor {
      grid-column: 2;
      text-align: left;
      margin-top: -0.6rem;
    }
  }

  @media (max-width: 640px) {
    .raffle-section {
      padding: 2rem 0 3.5rem;
    }

    .everyday-list {
      grid-template-columns: 1fr;
    }

    .prize-head h2 {
      font-size: 1.55rem;
    }
  }
</style>
