---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  raffleInfo,
  topPrizes,
  everydayRaffleCategories,
  otherRafflePrizes,
} from '../data/fairData';
---

<BaseLayout
  title="Raffle | Ashford School Christmas Fair 2026"
  description="Raffle prizes at the Ashford School Christmas Fair 2026: the £1 Christmas Fair Raffle and the £5 Super Raffle, with a £500 Neptune bar set up, £200 of PT sessions and more. Drawn on Saturday 28th November at 3:15pm in Main Reception."
>
  <Navbar />

  <main id="main-content">
    <header class="page-header">
      <div class="container">
        <p class="page-header__label">Raffle</p>
        <h1 class="page-header__title">Win something special</h1>
        <p class="page-header__intro">
          Two raffles, drawn on the day at 3:15pm in Main Reception. Every ticket helps fund
          initiatives and projects for the school community.
        </p>
      </div>
    </header>

    <section class="raffle-section">
      <div class="container">
        <dl class="raffle-facts">
          <div class="fact">
            <dt>Christmas Fair Raffle</dt>
            <dd>{raffleInfo.tickets.everyday.price}</dd>
          </div>
          <div class="fact">
            <dt>Super Raffle</dt>
            <dd>{raffleInfo.tickets.super.price}</dd>
          </div>
          <div class="fact">
            <dt>Super Raffle tickets</dt>
            <dd>Only {raffleInfo.tickets.super.limit} available</dd>
          </div>
          <div class="fact">
            <dt>Draw</dt>
            <dd>{raffleInfo.drawTime}</dd>
          </div>
        </dl>

        <p class="purchase-note">
          {raffleInfo.purchase}
          <span class="purchase-note__books">
            Or buy a {raffleInfo.books.everyday} for the Christmas Fair Raffle, and a{' '}
            {raffleInfo.books.super} for the Super Raffle.
          </span>
          {raffleInfo.drawDescription}
        </p>

        <p class="purchase-cta">
          <a class="button button--primary" href={raffleInfo.onlineUrl} target="_blank" rel="noopener noreferrer">
            Buy tickets online
            <span class="sr-only">(opens the PFA ticket page in a new tab)</span>
          </a>
          <span class="purchase-cta__note">
            Tickets are sold through the PFA's page on PTA Events.
          </span>
        </p>

        <section class="prize-block" aria-labelledby="top-prizes">
          <div class="prize-head">
            <h2 id="top-prizes">Top prizes</h2>
            <p class="prize-sub">Across both raffles &middot; values as printed on the 2026 poster</p>
          </div>
          <ul class="prize-cards">
            {
              topPrizes.map((prize) => (
                <li class="prize-card">
                  {prize.value && <span class="prize-card__value">{prize.value}</span>}
                  <span class="prize-card__item">{prize.item}</span>
                  <span class="prize-card__donor">
                    {prize.donor ? `Donated by ${prize.donor}` : 'Donor not listed'}
                  </span>
                  <span class="prize-card__foot">
                    <span class="prize-card__raffle">
                      {prize.raffle === 'super' ? 'Super Raffle' : 'Christmas Fair Raffle'}
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="prize-block" aria-labelledby="everyday-prizes">
          <div class="prize-head">
            <h2 id="everyday-prizes">The £1 Christmas Fair Raffle</h2>
            <p class="prize-sub">£1 a ticket &middot; drawn after the Super Raffle</p>
          </div>
          <p class="prize-lead">
            Every ticket is in with a chance of the prizes above plus a long list of others.
            The 2026 tickets promise:
          </p>
          <ul class="category-list">
            {everydayRaffleCategories.map((category) => <li>{category}</li>)}
          </ul>
        </section>

        <section class="prize-block" aria-labelledby="other-prizes">
          <div class="prize-head">
            <h2 id="other-prizes">Also to be won</h2>
            <p class="prize-sub">Donated with our sincere thanks</p>
          </div>
          <ul class="other-list">
            {otherRafflePrizes.map((prize) => <li>{prize}</li>)}
          </ul>
        </section>

        <p class="raffle-footnote">
          Prizes, values and donors are listed as printed by the Parents &amp; Friends Association
          on the 2026 raffle poster. Drawn on {raffleInfo.drawDate}.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .raffle-section {
    padding: 2.75rem 0 5rem;
  }

  .raffle-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    margin: 0 0 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .fact dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.3rem;
  }

  .fact dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.45;
  }

  .purchase-note {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 46rem;
    margin-bottom: 1.25rem;
  }

  .purchase-note__books {
    display: block;
    color: var(--text-primary);
  }

  .purchase-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.1rem;
    margin: 0 0 3rem;
  }

  .purchase-cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--pure-white);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .purchase-cta a:hover,
  .purchase-cta a:focus-visible {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .purchase-cta__note {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .prize-block {
    margin-bottom: 3rem;
  }

  .prize-head {
    margin-bottom: 1.35rem;
  }

  .prize-head h2 {
    font-size: 1.9rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .prize-sub {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  .prize-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  .prize-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.15rem 1.25rem 1.1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .prize-card__value {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .prize-card__item {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.4;
  }

  .prize-card__donor {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .prize-card__foot {
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .prize-card__raffle {
    display: inline-block;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-tint);
    border: 1px solid var(--border-subtle);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .prize-lead {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 46rem;
    margin: 0 0 1.1rem;
  }

  .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
  }

  .category-list li {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--evergreen);
    color: var(--pure-white);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .other-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .other-list li {
    padding: 0.7rem 0;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.92rem;
    color: var(--text-primary);
    line-height: 1.55;
  }

  .raffle-footnote {
    font-size: 0.85rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .raffle-facts {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .other-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .raffle-section {
      padding: 2rem 0 3.5rem;
    }

    .other-list {
      grid-template-columns: 1fr;
    }

    .prize-head h2 {
      font-size: 1.55rem;
    }

    .category-list li {
      font-size: 0.78rem;
    }
  }
</style>
