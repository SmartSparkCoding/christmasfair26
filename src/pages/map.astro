---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HarperHallMap from '../components/HarperHallMap.astro';
import CafePlan from '../components/CafePlan.astro';
import ZonePlan from '../components/ZonePlan.astro';
import {
  harperHallStalls,
  offHallStalls,
  buildingZones,
  groundZones,
  type SiteZone,
  type ZoneKind,
} from '../data/mapData';
import { eventInfo } from '../data/fairData';

const LEGEND_LABELS: Record<ZoneKind, string> = {
  building: 'Room or hall',
  stall: 'Stall',
  facility: 'Activity',
  outdoor: 'Outside',
  entrance: 'Entrance',
  path: 'Parking and paths',
};

const legendFor = (zones: SiteZone[]) =>
  [...new Set(zones.map((zone) => zone.kind))].map((kind) => ({
    kind,
    label: LEGEND_LABELS[kind],
  }));

const jumps = [
  { href: '#harper-hall', label: 'Harper Hall' },
  { href: '#cafe', label: 'Christmas Café' },
  { href: '#inside', label: 'Inside' },
  { href: '#outside', label: 'Outside' },
  { href: '#directory', label: 'Stall numbers' },
];
---

<BaseLayout
  title="Fair Map | Ashford School Christmas Fair 2026"
  description="Four plans of the Ashford School Christmas Fair 2026: the stalls in Harper Hall, the Christmas Café in Friars Hall, the ground floor of the main building, and the grounds outside."
>
  <Navbar />

  <main id="main-content">
    <header class="page-header">
      <div class="container">
        <p class="page-header__label">Fair map</p>
        <h1 class="page-header__title">Find your way around</h1>
        <p class="page-header__intro">
          Four plans, drawn from the PFA's own layouts: the stalls in Harper Hall, the Christmas Café,
          the ground floor of the main building, and the grounds outside. Every stallholder has a
          number.
        </p>

        <nav class="map-jump" aria-label="Jump to a plan">
          {jumps.map((jump) => <a href={jump.href}>{jump.label}</a>)}
        </nav>
      </div>
    </header>

    <section class="map-section" id="harper-hall">
      <div class="container">
        <div class="map-heading">
          <h2>The Hall of Stalls</h2>
          <p>
            Harper Hall holds stalls 1 to 22 in a ring around the room, with the entrance at the
            bottom. Stalls 23 to 27 are just outside, or in gazebos on the lawn.
          </p>
        </div>

        <HarperHallMap />

        <div class="map-note">
          <h3>Stalls outside Harper Hall</h3>
          <ul class="outside-list">
            {
              offHallStalls.map((stall) => (
                <li>
                  <span class="outside-list__no">{stall.no}</span>
                  <span>
                    <strong>{stall.name}</strong>
                    <span class="outside-list__where">{stall.where}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="map-section map-section--tint" id="cafe">
      <div class="container">
        <div class="map-heading">
          <h2>The Christmas Café</h2>
          <p>
            In Friars Hall. Food is served along the top wall, the queue runs one way to the till,
            and the tables sit in the middle of the room.
          </p>
        </div>

        <CafePlan />
      </div>
    </section>

    <section class="map-section" id="inside">
      <div class="container">
        <div class="map-heading">
          <h2>Inside the main building</h2>
          <p>
            The ground floor: reception and the raffle, the tombolas, the Christingle room, Santa's
            Grotto, face painting and the stairs up to the café.
          </p>
        </div>

        <ZonePlan
          zones={buildingZones}
          viewBox="0 0 1000 707"
          label="Plan of the ground floor of the main building"
          legend={legendFor(buildingZones)}
          note="Tap any room or area on the plan to read what is there."
        />
      </div>
    </section>

    <section class="map-section map-section--tint" id="outside">
      <div class="container">
        <div class="map-heading">
          <h2>Outside</h2>
          <p>
            The grounds: the main entrance, the gazebos on the lawn, the rides, the mulled wine horse
            box, and where you can and cannot park.
          </p>
        </div>

        <ZonePlan
          zones={groundZones}
          viewBox="0 0 1000 707"
          label="Plan of the fair grounds outside the main building"
          legend={legendFor(groundZones)}
          note="Tap any area on the plan to read what is there."
        />
      </div>
    </section>

    <section class="map-section" id="directory">
      <div class="container">
        <div class="map-heading">
          <h2>Stallholder directory</h2>
          <p>All {harperHallStalls.length + offHallStalls.length} numbered stalls, in order.</p>
        </div>

        <ol class="directory">
          {
            [...harperHallStalls, ...offHallStalls].map((stall) => (
              <li class="directory__item">
                <span class="directory__no">{stall.no}</span>
                <span class="directory__name">{stall.name}</span>
                <span class="directory__where">
                  {'where' in stall ? stall.where : 'Harper Hall'}
                </span>
              </li>
            ))
          }
        </ol>

        <p class="map-disclaimer">
          It has to be pretty has two stalls (15 and 16) and so does PFA Kids (21 and 22), which is
          why those names appear twice.
        </p>

        <p class="map-disclaimer">
          The plans are traced from the PFA's floor plan, site plan and café layout, so they show
          where things sit relative to each other rather than exact distances. Layouts can change on
          the day, so follow signage and ask at the Welcome Point in Main Reception if you cannot
          find someone. The fair runs {eventInfo.time} on {eventInfo.date}.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .map-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .map-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
  }

  .map-jump a:hover,
  .map-jump a:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .map-section {
    padding: 3rem 0;
    scroll-margin-top: 5rem;
  }

  .map-section--tint {
    background: var(--surface-tint);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .map-heading {
    max-width: 62ch;
    margin-bottom: 1.75rem;
  }

  .map-heading h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    color: var(--navy);
  }

  .map-heading p {
    margin: 0;
    color: var(--text-secondary);
  }

  .map-note {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .map-note h3 {
    margin: 0 0 1rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--navy);
  }

  .outside-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .outside-list li {
    display: flex;
    gap: 0.85rem;
    align-items: baseline;
  }

  .outside-list__no {
    flex: 0 0 1.9rem;
    height: 1.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--evergreen);
    color: var(--pure-white);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .outside-list__where {
    display: block;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .directory {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.5rem 1.5rem;
  }

  .directory__item {
    display: grid;
    grid-template-columns: 1.9rem 1fr;
    grid-template-areas:
      'no name'
      'no where';
    column-gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .directory__no {
    grid-area: no;
    align-self: center;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--accent);
  }

  .directory__name {
    grid-area: name;
    font-weight: 600;
    color: var(--text-primary);
  }

  .directory__where {
    grid-area: where;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .map-disclaimer {
    margin: 2rem 0 0;
    max-width: 70ch;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .map-section {
      padding: 2.25rem 0;
    }

    .map-jump a {
      font-size: 0.8rem;
      padding: 0.35rem 0.8rem;
    }
  }
</style>
