---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { programme } from '../data/fairData';

const categories = ['All', ...Array.from(new Set(programme.map((item) => item.category)))];
---

<BaseLayout
  title="Programme | Ashford School Christmas Fair 2026"
  description="The full programme for the Ashford School Christmas Fair 2026: performances, Santa's Grotto, fairground rides, Christingle room and the raffle draw."
>
  <Navbar />

  <main id="main-content">
    <header class="page-header">
      <div class="container">
        <p class="page-header__label">Digital programme</p>
        <h1 class="page-header__title">The day's events</h1>
        <p class="page-header__intro">
          Performances, attractions and activities running throughout the afternoon at the Great
          Chart site. Times and locations are as published by the PFA.
        </p>
      </div>
    </header>

    <section class="programme-section">
      <div class="container">
        <div class="toolbar">
          <div class="filters" role="group" aria-label="Filter programme by category">
            {
              categories.map((category, index) => (
                <button
                  class:list={['filter', { 'is-active': index === 0 }]}
                  type="button"
                  data-filter={category}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  {category === 'All' ? 'All events' : category}
                </button>
              ))
            }
          </div>
          <button type="button" class="print-button" id="printProgramme">
            Print programme
          </button>
        </div>

        <p class="result-count" id="resultCount" aria-live="polite">
          {programme.length} entries
        </p>

        <ol class="programme-list" id="programmeList">
          {
            programme.map((item) => (
              <li class="entry" data-category={item.category} id={item.id}>
                <div class="entry__time">
                  <span>{item.time}</span>
                </div>
                <div class="entry__body">
                  <h2 class="entry__title">{item.name}</h2>
                  <p class="entry__location">{item.location}</p>
                  <p class="entry__description">{item.description}</p>
                </div>
                <div class="entry__meta">
                  <span class="entry__tag">{item.category}</span>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="empty-state" id="emptyState" hidden>
          No events match that filter. <button type="button" class="empty-reset" id="resetFilters">
            Show all events
          </button>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
  const entries = Array.from(document.querySelectorAll<HTMLElement>('.entry'));
  const emptyState = document.getElementById('emptyState');
  const resultCount = document.getElementById('resultCount');
  const resetButton = document.getElementById('resetFilters');
  const printButton = document.getElementById('printProgramme');

  const applyFilter = (filter: string) => {
    let visible = 0;

    entries.forEach((entry) => {
      const matches = filter === 'All' || entry.dataset.category === filter;
      entry.hidden = !matches;
      if (matches) visible += 1;
    });

    buttons.forEach((button) => {
      const isActive = button.dataset.filter === filter;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    if (emptyState) emptyState.hidden = visible > 0;
    if (resultCount) {
      resultCount.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
    }
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => applyFilter(button.dataset.filter as string));
  });

  resetButton?.addEventListener('click', () => applyFilter('All'));
  printButton?.addEventListener('click', () => window.print());
</script>

<style>
  .programme-section {
    padding: 3rem 0 5rem;
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .filters {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .filter {
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--navy);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .filter:hover {
    border-color: var(--navy);
  }

  .filter.is-active {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--pure-white);
  }

  .print-button {
    background: transparent;
    border: 1px solid var(--navy);
    color: var(--navy);
    border-radius: var(--radius-md);
    padding: 0.5rem 1.1rem;
    font-size: 0.84rem;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .print-button:hover {
    background: var(--navy);
    color: var(--pure-white);
  }

  .result-count {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 600;
    margin: 1.1rem 0 0;
  }

  .programme-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 190px 1fr 110px;
    gap: 2rem;
    padding: 1.9rem 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: start;
  }

  .entry:first-child {
    border-top: 1px solid var(--border-subtle);
  }

  .entry__time span {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--secondary);
    display: block;
    line-height: 1.5;
  }

  .entry__title {
    font-size: 1.7rem;
    line-height: 1.22;
    margin-bottom: 0.4rem;
  }

  .entry__location {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  .entry__description {
    font-size: 0.97rem;
    line-height: 1.75;
    color: var(--text-primary);
    margin: 0;
    max-width: 46rem;
  }

  .entry__meta {
    text-align: right;
  }

  .entry__tag {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(161, 24, 52, 0.28);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    white-space: nowrap;
  }

  .empty-state {
    padding: 2.5rem 0;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.98rem;
  }

  .empty-reset {
    background: none;
    border: none;
    padding: 0;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .entry {
      grid-template-columns: 150px 1fr;
      gap: 1.5rem;
    }

    .entry__meta {
      grid-column: 2;
      text-align: left;
      margin-top: -0.4rem;
    }
  }

  @media (max-width: 640px) {
    .programme-section {
      padding: 2rem 0 3.5rem;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 1.5rem 0;
    }

    .entry__title {
      font-size: 1.4rem;
    }

    .entry__meta {
      grid-column: 1;
      margin-top: 0;
    }

    .toolbar {
      align-items: flex-start;
    }
  }

  @media print {
    .toolbar,
    .result-count,
    .empty-state {
      display: none !important;
    }

    .entry {
      break-inside: avoid;
      page-break-inside: avoid;
      padding: 0.85rem 0;
      border-bottom: 1px solid #d8d8d8;
    }

    .entry__title {
      font-size: 1.15rem;
      color: #000;
    }

    .entry__time span {
      color: #000;
    }

    .entry__tag {
      color: #333;
      border: 0;
      padding: 0;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }

    @page {
      margin: 18mm 16mm;
    }

    .entry__description {
      font-size: 0.85rem;
    }
  }
</style>
