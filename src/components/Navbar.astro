---
import { eventInfo } from '../data/fairData';
---

<nav class="navbar">
  <div class="nav-top">
    <div class="container nav-top-container">
      <div class="nav-school-brand">
        <img src="/images/ashford-logo.png" alt="Ashford School" class="nav-logo" />
        <span class="nav-school-name">Ashford School</span>
      </div>
      <div class="nav-event-info">
        <span>📅 {eventInfo.date}</span>
        <span>🕐 {eventInfo.time}</span>
        <span>📍 {eventInfo.location}</span>
      </div>
    </div>
  </div>
  <div class="nav-main">
    <div class="container nav-main-container">
      <a href="/" class="nav-brand">
        <span class="nav-brand-title">Christmas Fair</span>
        <span class="nav-brand-year">2026</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <ul class="nav-menu" id="navMenu">
        <li class="nav-item">
          <a href="/" class="nav-link">Home</a>
        </li>
        <li class="nav-item">
          <a href="/programme" class="nav-link">Programme</a>
        </li>
        <li class="nav-item">
          <a href="/stalls" class="nav-link">Stalls</a>
        </li>
        <li class="nav-item">
          <a href="/visitor-info" class="nav-link">Visitor Info</a>
        </li>
        <li class="nav-item">
          <a href="/raffle" class="nav-link">Raffle</a>
        </li>
      </ul>
      <a href="/programme" class="nav-cta">View Programme</a>
    </div>
  </div>
</nav>

<script>
  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');
  
  if (navToggle && navMenu) {
    navToggle.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      navMenu.classList.toggle('active');
    });
    
    const navLinks = navMenu.querySelectorAll('.nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navToggle.setAttribute('aria-expanded', 'false');
        navMenu.classList.remove('active');
      });
    });
  }
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--warm-cream);
    box-shadow: 0 2px 20px rgba(22, 41, 74, 0.08);
  }
  
  .nav-top {
    background: var(--navy);
    color: var(--white);
    padding: 0.5rem 0;
    font-size: 0.8rem;
  }
  
  .nav-top-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  
  .nav-school-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .nav-logo {
    height: 32px;
    width: auto;
  }
  
  .nav-school-name {
    font-weight: 600;
    font-size: 0.875rem;
  }
  
  .nav-event-info {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    opacity: 0.95;
  }
  
  .nav-main {
    background: rgba(248, 245, 237, 0.98);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .nav-main-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    gap: 2rem;
  }
  
  .nav-brand {
    display: flex;
    flex-direction: column;
    font-family: var(--font-serif);
    line-height: 1;
  }
  
  .nav-brand-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -0.02em;
  }
  
  .nav-brand-year {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent);
    font-style: italic;
  }
  
  .nav-toggle {
    display: none;
    background: transparent;
    border: 2px solid var(--border-subtle);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--navy);
  }
  
  .nav-toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--navy);
    margin: 5px 0;
  }
  
  .nav-menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.5rem;
    align-items: center;
    flex: 1;
    justify-content: center;
  }
  
  .nav-link {
    color: var(--navy);
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.5rem 0;
    position: relative;
    transition: color 0.2s ease;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s ease;
  }
  
  .nav-link:hover {
    color: var(--accent);
  }
  
  .nav-link:hover::after {
    width: 100%;
  }
  
  .nav-cta {
    background: var(--accent);
    color: var(--white);
    padding: 0.625rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  
  .nav-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(161, 24, 52, 0.25);
  }
  
  @media (max-width: 968px) {
    .nav-event-info {
      display: none;
    }
    
    .nav-cta {
      display: none;
    }
    
    .nav-menu {
      gap: 1.5rem;
    }
  }
  
  @media (max-width: 768px) {
    .nav-toggle {
      display: block;
    }
    
    .nav-menu {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--warm-cream);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 0.5rem 0;
      margin-top: 1rem;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      box-shadow: 0 4px 20px rgba(22, 41, 74, 0.1);
    }
    
    .nav-menu.active {
      display: flex;
    }
    
    .nav-main-container {
      position: relative;
    }
    
    .nav-item {
      width: 100%;
    }
    
    .nav-link {
      display: block;
      padding: 0.875rem 1.5rem;
      width: 100%;
    }
    
    .nav-link::after {
      display: none;
    }
  }
</style>
