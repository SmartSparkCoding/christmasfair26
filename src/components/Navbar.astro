---
import { eventInfo } from '../data/fairData';
---

<a href="#main-content" class="skip-link">Skip to content</a>

<header class="navbar">
  <div class="nav-top">
    <div class="container nav-top-container">
      <div class="nav-school-brand">
        <img src="/images/ashford-crest.png" alt="" class="nav-crest" width="30" height="41" />
        <span class="nav-school-name">Ashford School</span>
      </div>
      <div class="nav-event-info">
        <span class="nav-meta-item">{eventInfo.date}</span>
        <span class="nav-meta-divider" aria-hidden="true"></span>
        <span class="nav-meta-item">{eventInfo.time}</span>
        <span class="nav-meta-divider" aria-hidden="true"></span>
        <a
          class="nav-meta-item nav-meta-link"
          href={eventInfo.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {eventInfo.location}
          <span class="sr-only">(opens in Google Maps)</span>
        </a>
      </div>
    </div>
  </div>
  <div class="nav-main">
    <div class="container nav-main-container">
      <a href="/" class="nav-brand">
        <span class="nav-brand-title">Christmas Fair <em>2026</em></span>
      </a>
      <button
        class="nav-toggle"
        id="navToggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="navMenu"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <ul class="nav-menu" id="navMenu">
        <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
        <li class="nav-item"><a href="/programme" class="nav-link">Programme</a></li>
        <li class="nav-item"><a href="/stalls" class="nav-link">Stalls</a></li>
        <li class="nav-item"><a href="/visitor-info" class="nav-link">Visitor Info</a></li>
        <li class="nav-item"><a href="/raffle" class="nav-link">Raffle</a></li>
      </ul>
      <a href="/programme" class="nav-cta">View Programme</a>
    </div>
  </div>
</header>

<script>
  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');

  if (navToggle && navMenu) {
    const setOpen = (open: boolean) => {
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      navToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      navMenu.classList.toggle('active', open);
    };

    navToggle.addEventListener('click', () => {
      setOpen(navToggle.getAttribute('aria-expanded') !== 'true');
    });

    navMenu.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }

  // Highlight the current page in the navigation.
  const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
  document.querySelectorAll('.nav-link').forEach((link) => {
    const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';
    if (href === currentPath) {
      link.setAttribute('aria-current', 'page');
      link.classList.add('is-current');
    }
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    background: var(--navy);
    color: var(--pure-white);
    padding: 0.75rem 1.25rem;
    border-radius: 0 0 var(--radius-md) 0;
    font-weight: 600;
  }

  .skip-link:focus {
    left: 0;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--warm-cream);
    box-shadow: 0 1px 0 rgba(22, 41, 74, 0.08);
  }

  .nav-top {
    background: var(--navy);
    color: var(--pure-white);
    padding: 0.5rem 0;
  }

  .nav-top-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .nav-school-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .nav-logo {
    height: 30px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .nav-crest {
    height: 34px;
    width: auto;
  }

  .nav-school-name {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pure-white);
  }

  .nav-event-info {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
  }

  .nav-meta-item {
    color: rgba(255, 255, 255, 0.92);
    white-space: nowrap;
  }

  .nav-meta-divider {
    width: 1px;
    height: 12px;
    background: rgba(255, 255, 255, 0.3);
  }

  .nav-meta-link {
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 3px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .nav-meta-link:hover {
    color: var(--gold);
    text-decoration-color: var(--gold);
  }

  .nav-main {
    background: rgba(248, 245, 237, 0.97);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-main-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
    gap: 1.5rem;
    position: relative;
  }

  .nav-brand {
    display: flex;
    align-items: baseline;
    font-family: var(--font-serif);
    line-height: 1.05;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-brand-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -0.015em;
  }

  .nav-brand-title em {
    font-style: italic;
    font-weight: 600;
    color: var(--accent);
    margin-left: 0.15em;
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border-subtle);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--navy);
    line-height: 0;
  }

  .nav-toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--navy);
    margin: 5px 0;
  }

  .nav-menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.25rem;
    align-items: center;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    color: var(--navy);
    font-weight: 500;
    font-size: 0.94rem;
    padding: 0.4rem 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.is-current {
    color: var(--accent);
  }

  .nav-link:hover::after,
  .nav-link.is-current::after {
    width: 100%;
  }

  .nav-cta {
    background: var(--accent);
    color: var(--pure-white);
    padding: 0.6rem 1.4rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.88rem;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(161, 24, 52, 0.25);
  }

  @media (max-width: 1000px) {
    .nav-event-info {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .nav-menu {
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: block;
    }

    .nav-menu {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--warm-cream);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 0.4rem 0;
      margin-top: 0.75rem;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      box-shadow: 0 10px 30px rgba(22, 41, 74, 0.12);
    }

    .nav-menu.active {
      display: flex;
    }

    .nav-link {
      display: block;
      padding: 0.8rem 1.25rem;
      width: 100%;
    }

    .nav-link::after {
      display: none;
    }
  }
</style>
