---
import { harperHallStalls } from '../data/mapData';

const stalls = harperHallStalls;
---

<div class="hall-map" data-hall-map>
  <div class="hall-map__canvas">
    <svg
      class="hall-map__svg"
      viewBox="288 -22 624 464"
      role="group"
      aria-label="Plan of Harper Hall showing stalls 1 to 22 in a ring"
    >
      <rect class="hall-floor" x="300" y="20" width="600" height="400" rx="18" />

      <!-- Entrance marker, top of the plan -->
      <g class="hall-entrance">
        <path d="M470 20 v-14 M530 20 v-14" />
        <text x="500" y="0" text-anchor="middle">Entrance</text>
      </g>

      {
        stalls.map((stall) => (
          <g
            class:list={['stall-block', `stall-block--${stall.kind}`]}
            data-stall-no={stall.no}
            data-stall-name={stall.name}
            data-stall-note={stall.note ?? ''}
            tabindex="0"
            role="button"
            aria-label={`Stall ${stall.no}, ${stall.name}`}
          >
            <rect
              x={stall.cx - stall.w / 2}
              y={stall.cy - stall.h / 2}
              width={stall.w}
              height={stall.h}
              rx="6"
              transform={stall.rot ? `rotate(${stall.rot} ${stall.cx} ${stall.cy})` : undefined}
            />
            <text
              x={stall.cx}
              y={stall.cy + 6}
              text-anchor="middle"
              transform={stall.rot ? `rotate(${stall.rot} ${stall.cx} ${stall.cy})` : undefined}
            >
              {stall.no}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <div class="hall-map__side">
    <div class="hall-detail" aria-live="polite">
      <p class="hall-detail__label">Selected stall</p>
      <p class="hall-detail__name" data-detail-name>Tap a stall on the plan</p>
      <p class="hall-detail__meta" data-detail-meta>
        Stalls 1–22 are in the ring inside Harper Hall. Stalls 23–27 are elsewhere on site.
      </p>
    </div>

    <div class="hall-search">
      <label class="hall-search__label" for="hallStallSearch">Find a stallholder</label>
      <input
        class="hall-search__input"
        id="hallStallSearch"
        type="search"
        placeholder="Search by name"
        autocomplete="off"
      />
    </div>

    <ul class="hall-list" data-hall-list>
      {
        stalls.map((stall) => (
          <li>
            <button
              type="button"
              class="hall-list__item"
              data-list-no={stall.no}
              data-list-name={stall.name.toLowerCase()}
            >
              <span class="hall-list__no">{stall.no}</span>
              <span class="hall-list__name">{stall.name}</span>
            </button>
          </li>
        ))
      }
    </ul>
    <p class="hall-list__empty" data-hall-empty hidden>No stall matches that search.</p>
  </div>
</div>

<style>
  .hall-map {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 1.75rem;
    align-items: start;
  }

  .hall-map__canvas {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .hall-map__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hall-floor {
    fill: var(--surface-tint);
    stroke: var(--border-subtle);
    stroke-width: 1.5;
  }

  .hall-entrance path {
    stroke: var(--text-secondary);
    stroke-width: 2;
    fill: none;
  }

  .hall-entrance text {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--text-secondary);
  }

  .stall-block {
    cursor: pointer;
    outline: none;
  }

  .stall-block rect {
    stroke: transparent;
    stroke-width: 2.5;
    transition:
      fill 0.15s ease,
      stroke 0.15s ease;
  }

  .stall-block--independent rect {
    fill: var(--evergreen);
  }

  .stall-block--pfa rect {
    fill: var(--christmas-burgundy);
  }

  .stall-block text {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    fill: var(--pure-white);
    pointer-events: none;
  }

  .stall-block:hover rect,
  .stall-block:focus-visible rect {
    fill: var(--navy);
  }

  .stall-block.is-active rect {
    fill: var(--navy);
    stroke: var(--soft-gold);
  }

  .stall-block.is-dimmed {
    opacity: 0.28;
  }

  .hall-map__side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hall-detail {
    background: var(--navy);
    color: var(--pure-white);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem;
  }

  .hall-detail__label {
    margin: 0 0 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft-gold);
  }

  .hall-detail__name {
    margin: 0;
    color: var(--pure-white);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .hall-detail__meta {
    margin: 0.4rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
  }

  .hall-search__label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .hall-search__input {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--text-primary);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .hall-search__input:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 1px;
  }

  .hall-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 320px;
    overflow-y: auto;
    border-top: 1px solid var(--border-subtle);
  }

  .hall-list__item {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    width: 100%;
    padding: 0.5rem 0.25rem;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--border-subtle);
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    color: var(--text-primary);
    cursor: pointer;
  }

  .hall-list__item:hover,
  .hall-list__item:focus-visible {
    background: var(--surface-tint);
    outline: none;
  }

  .hall-list__item.is-active {
    background: var(--surface-tint);
    font-weight: 600;
  }

  .hall-list__no {
    flex: 0 0 1.6rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--accent);
  }

  .hall-list__empty {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .hall-map {
      grid-template-columns: 1fr;
    }

    .hall-list {
      max-height: 240px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hall-map]');
  if (root) {
    const blocks = Array.from(root.querySelectorAll<SVGGElement>('.stall-block'));
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('.hall-list__item'));
    const nameEl = root.querySelector<HTMLElement>('[data-detail-name]');
    const metaEl = root.querySelector<HTMLElement>('[data-detail-meta]');
    const search = root.querySelector<HTMLInputElement>('#hallStallSearch');
    const empty = root.querySelector<HTMLElement>('[data-hall-empty]');

    const select = (no: string) => {
      const block = blocks.find((b) => b.dataset.stallNo === no);
      if (!block || !nameEl || !metaEl) return;

      blocks.forEach((b) => b.classList.toggle('is-active', b === block));
      items.forEach((i) => i.classList.toggle('is-active', i.dataset.listNo === no));

      nameEl.textContent = block.dataset.stallName ?? '';
      const note = block.dataset.stallNote;
      metaEl.textContent = note
        ? note
        : `Stall ${no} in Harper Hall. Ask at the Welcome Point in Main Reception if you need help finding it.`;
    };

    blocks.forEach((block) => {
      block.addEventListener('click', () => select(block.dataset.stallNo ?? ''));
      block.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select(block.dataset.stallNo ?? '');
        }
      });
    });

    items.forEach((item) => {
      item.addEventListener('click', () => select(item.dataset.listNo ?? ''));
    });

    search?.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const match = !query || (item.dataset.listName ?? '').includes(query);
        item.parentElement?.toggleAttribute('hidden', !match);
        if (match) visible += 1;
      });

      blocks.forEach((block) => {
        const match = !query || (block.dataset.stallName ?? '').toLowerCase().includes(query);
        block.classList.toggle('is-dimmed', !match);
      });

      empty?.toggleAttribute('hidden', visible > 0);
    });
  }
</script>
