---
import MapFrame from './MapFrame.astro';
import { harperHallStalls, harperHallFloor } from '../data/mapData';

const floor = harperHallFloor;
const wall = [
  `M${floor.x},${floor.y} H${floor.x + floor.w}`,
  `M${floor.x},${floor.y} V${floor.y + floor.h}`,
  `M${floor.x + floor.w},${floor.y} V${floor.y + floor.h}`,
  // Bottom wall, with a gap for each set of double doors.
  `M${floor.x},${floor.y + floor.h} H${floor.x + 20}`,
  `M${floor.x + 80},${floor.y + floor.h} H${floor.x + floor.w - 80}`,
  `M${floor.x + floor.w - 20},${floor.y + floor.h} H${floor.x + floor.w}`,
].join(' ');

const doors = [
  { x: floor.x + 20, w: 60 },
  { x: floor.x + floor.w - 80, w: 60 },
];
---

<div class="hall-map">
  <div class="hall-map__frame">
    <MapFrame label="Harper Hall plan" hint="Tap a stall for details. Swipe to look around the hall.">
    <svg
      class="hall-svg"
      viewBox="290 90 620 510"
      role="group"
      aria-label="Plan of Harper Hall showing stalls 1 to 22 in a ring, with a stallholder list alongside"
    >
      <rect
        class="hall-floor"
        x={floor.x}
        y={floor.y}
        width={floor.w}
        height={floor.h}
        rx="16"></rect>
      <path class="hall-wall" d={wall}></path>

      {doors.map((door) => (
        <g class="hall-door">
          <line
            x1={door.x}
            y1={floor.y + floor.h}
            x2={door.x + door.w}
            y2={floor.y + floor.h}
          />
          <text x={door.x + door.w / 2} y={floor.y + floor.h + 24} text-anchor="middle">
            Entrance
          </text>
        </g>
      ))}

      <text class="hall-marker" x={floor.x + 4} y={floor.y - 14}>Top of the hall</text>
      <text class="hall-marker" x={floor.x + floor.w - 4} y={floor.y - 14} text-anchor="end">
        Home Plus 23 and Impact Squad outside
      </text>

      {harperHallStalls.map((stall) => (
        <g
          class:list={['stall-block', `stall-block--${stall.kind}`]}
          data-stall-no={stall.no}
          data-stall-name={stall.name}
          data-stall-note={stall.note}
          tabindex="0"
          role="button"
          aria-label={`Stall ${stall.no}, ${stall.name}`}
        >
          <rect
            x={stall.cx - stall.w / 2}
            y={stall.cy - stall.h / 2}
            width={stall.w}
            height={stall.h}
            rx="5"
            transform={stall.rot ? `rotate(${stall.rot} ${stall.cx} ${stall.cy})` : undefined}
          />
          <text
            x={stall.cx}
            y={stall.cy}
            transform={stall.rot ? `rotate(${stall.rot} ${stall.cx} ${stall.cy})` : undefined}>
            {stall.no}
          </text>
        </g>
      ))}
    </svg>
  </MapFrame>
  </div>

  <div class="hall-side">
    <div class="hall-detail" aria-live="polite">
      <p class="hall-detail__label">Selected stall</p>
      <p class="hall-detail__name" data-detail-name>Tap a stall on the plan</p>
      <p class="hall-detail__meta" data-detail-meta>
        Stalls 1–22 are in the ring inside the hall. 23–27 are on the other plans further down this
        page.
      </p>
    </div>

    <label class="hall-search" for="hallStallSearch">Find a stallholder</label>
    <input
      class="hall-search__input"
      id="hallStallSearch"
      type="search"
      placeholder="Search by name"
      autocomplete="off"
    />

    <ul class="hall-list" data-hall-list>
      {harperHallStalls.map((stall) => (
        <li>
          <button type="button" data-list-no={stall.no} data-list-name={stall.name.toLowerCase()}>
            <span class="hall-list__no">{stall.no}</span>
            <span class="hall-list__name">{stall.name}</span>
          </button>
        </li>
      ))}
    </ul>
    <p class="hall-empty" data-hall-empty hidden>No stall matches that search.</p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.hall-map');
  if (root) {
    const nameEl = root.querySelector<HTMLElement>('[data-detail-name]')!;
    const metaEl = root.querySelector<HTMLElement>('[data-detail-meta]')!;
    const blocks = [...root.querySelectorAll<SVGGElement>('.stall-block')];
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-list-no]')];
    const input = root.querySelector<HTMLInputElement>('#hallStallSearch');
    const empty = root.querySelector<HTMLElement>('[data-hall-empty]')!;
    const list = root.querySelector<HTMLElement>('[data-hall-list]')!;

    let active: number | null = null;

    const select = (no: number | null) => {
      active = no;
      blocks.forEach((block) => {
        block.classList.toggle('is-active', Number(block.dataset.stallNo) === no);
      });
      if (no === null) {
        nameEl.textContent = 'Tap a stall on the plan';
        metaEl.textContent =
          'Stalls 1–22 are in the ring inside the hall. 23–27 are on the other plans further down this page.';
        return;
      }
      const block = blocks.find((b) => Number(b.dataset.stallNo) === no);
      if (!block) return;
      nameEl.textContent = block.dataset.stallName ?? '';
      metaEl.textContent =
        block.dataset.stallNote ??
        `Stall ${no} in Harper Hall. Ask at the Welcome Point in Main Reception for help.`;
    };

    blocks.forEach((block) => {
      const no = Number(block.dataset.stallNo);
      block.addEventListener('click', () => select(no));
      block.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select(no);
        }
      });
    });

    items.forEach((item) => {
      const no = Number(item.dataset.listNo);
      item.addEventListener('click', () => select(no));
    });

    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((item) => {
        const li = item.closest('li')!;
        const matches = query === '' || (item.dataset.listName ?? '').includes(query);
        li.hidden = !matches;
        if (matches) shown += 1;
      });
      blocks.forEach((block) => {
        const matches =
          query === '' || (block.dataset.stallName ?? '').toLowerCase().includes(query);
        block.classList.toggle('is-dimmed', !matches);
      });
      empty.hidden = shown > 0;
      list.hidden = shown === 0;
      if (shown === 0) select(null);
    });
  }
</script>

<style>
  .hall-map__frame {
    max-width: 820px;
    margin: 0 auto;
  }

  .hall-svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface-tint);
  }

  .hall-floor {
    fill: var(--pure-white);
  }

  .hall-wall {
    fill: none;
    stroke: var(--ashford-navy);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .hall-door line {
    stroke: var(--pure-white);
    stroke-width: 7;
  }

  .hall-door text {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--muted-text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hall-marker {
    font-family: var(--font-sans);
    font-size: 12px;
    fill: var(--muted-text);
    letter-spacing: 0.04em;
  }

  .stall-block rect {
    fill: var(--evergreen);
    stroke: none;
    transition: fill 120ms ease;
  }

  .stall-block--pfa rect {
    fill: var(--christmas-burgundy);
  }

  .stall-block text {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 700;
    fill: var(--pure-white);
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  .stall-block {
    cursor: pointer;
    outline: none;
    transition: opacity 120ms ease;
  }

  .stall-block:hover rect,
  .stall-block:focus-visible rect {
    fill: var(--ashford-navy);
  }

  .stall-block.is-active rect {
    fill: var(--ashford-navy);
    stroke: var(--soft-gold);
    stroke-width: 3;
  }

  .stall-block.is-dimmed {
    opacity: 0.22;
  }

  .hall-side {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 820px;
    margin: 1.25rem auto 0;
  }

  .hall-detail {
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--ashford-navy);
    color: var(--pure-white);
  }

  .hall-detail__label {
    margin: 0 0 0.3rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft-gold);
  }

  .hall-detail__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--pure-white);
  }

  .hall-detail__meta {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
  }

  .hall-search {
    margin-top: 0.15rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .hall-search__input {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--pure-white);
    font: inherit;
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .hall-search__input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .hall-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.15rem 0.75rem;
    max-height: 16rem;
    margin: 0;
    padding: 0.15rem 0.35rem 0.15rem 0;
    overflow-y: auto;
    list-style: none;
  }

  .hall-list button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.5rem 0.55rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    font: inherit;
    font-size: 0.9rem;
    color: var(--text-primary);
    text-align: left;
    cursor: pointer;
  }

  .hall-list button:hover,
  .hall-list button:focus-visible {
    background: var(--surface-tint);
  }

  .hall-list__no {
    flex: none;
    min-width: 1.55rem;
    padding: 0.1rem 0.3rem;
    border-radius: 999px;
    background: var(--evergreen);
    color: var(--pure-white);
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .hall-empty {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .hall-list {
      max-height: 13rem;
    }
  }
</style>
